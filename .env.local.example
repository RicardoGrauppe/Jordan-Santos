# Supabase (as duas do projeto; a service role NUNCA vai pro cliente)
SUPABASE_URL="https://<projeto>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
# segredo do cookie de sessão; sem ele, deriva da service role
SESSION_SECRET=""
# envio de e-mail
RESEND_API_KEY=""
# opcional: e-mail que vale como admin além do app_metadata.role
ADMIN_EMAIL=""

# Autentique (assinatura do contrato, desde 21/10/2026). A chave é da conta do
# FOTÓGRAFO: é o nome dela que o casal vê no pedido de assinatura.
AUTENTIQUE_API_TOKEN=
# "true" manda tudo pra sandbox: documento de teste, não gasta a cota de 10/mês
AUTENTIQUE_SANDBOX=true
# segredos dos webhooks (opcionais; sem eles a rota aceita o aviso e confere o
# estado direto na API, que é de onde ela tira a verdade de qualquer jeito)
AUTENTIQUE_WEBHOOK_SECRET_DOCUMENTO=
AUTENTIQUE_WEBHOOK_SECRET_ASSINATURA=
